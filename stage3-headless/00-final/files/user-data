#cloud-config

# Set the hostname for this device. This will also update /etc/hosts if manage_etc_hosts is enabled.
hostname: testbuild
manage_etc_hosts: true

# 1. Schrijf de Auth Key rechtstreeks naar de thuismap van de gebruiker 'pi'
write_files:
  - path: /home/pi/.config/com.raspberrypi.connect/auth.key
    owner: pi:pi
    permissions: '0600'
    content: |
      JOUW_RPI_CONNECT_AUTH_KEY

# 2. Activeer en start de achtergrondservice direct via de terminal
runcmd:
  # Zorg dat user-services actief blijven zonder dat de gebruiker 'pi' fysiek is ingelogd
  - loginctl enable-linger pi

  # Schakel de connect-lite service in onder de gebruiker 'pi'
  - sudo -u pi rpi-connect-lite on

  # Herstart de user-service zodat de nieuwe auth.key direct wordt uitgelezen
  - systemctl --user -M pi restart rpi-connect-lite

  - nmcli dev set usb0 managed yes

keyboard:
    layout: us

# Create a default user account and apply permissions
users:
  - name: pi
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: raspberry
    sudo: ALL=(ALL) NOPASSWD:ALL  # Allow passwordless sudo for this user

  # CUSTOM USER - Remove # in front of the following lines and replace USERNAME and PASSWORD
  # with your desired username and password to create an additional user account with sudo privileges.
  #- name: USERNAME
  #  groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
  #  shell: /bin/bash
  #  lock_passwd: false
  #  plain_text_passwd: PASSWORD
  #  sudo: ALL=(ALL) NOPASSWD:ALL  # Allow passwordless sudo for this user

# Raspberry Pi–specific options (provided by the cc_raspberry_pi module)
rpi:
    enable_usb_gadget: true # Enable USB gadget mode
    interfaces:
        spi: true               # Enable SPI interface
        i2c: true               # Enable I2C interface

# Additional Raspberry Pi OS option (not available on generic cloud-init images)
enable_ssh: true  # Enables the SSH server on first boot
ssh_pwauth: true  # Allow password authentication for SSH (not recommended for production environments)