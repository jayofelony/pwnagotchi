#!/usr/bin/env bash

# waits for a network interface to appear in sysfs, polling instead of a blind sleep
wait_for_interface() {
  local iface="$1"
  local timeout="${2:-10}"
  while [ ! -e "/sys/class/net/$iface" ] && [ "$timeout" -gt 0 ]; do
    sleep 0.5
    timeout=$((timeout - 1))
  done
  [ -e "/sys/class/net/$iface" ]
}

# resolves the phy (e.g. "phy0") that a given interface actually belongs to,
# instead of assuming it's whatever "iw phy" lists first
phy_for_interface() {
  local iface="$1"
  if [ -e "/sys/class/net/$iface/phy80211/name" ]; then
    cat "/sys/class/net/$iface/phy80211/name"
  else
    iw dev "$iface" info 2>/dev/null | awk '/wiphy/ {print "phy" $2}'
  fi
}

# true when dmesg shows the brcmfmac firmware has wedged the SDIO backplane
# itself (nexmon's patched firmware occasionally locks up under sustained
# monitor-mode/injection load). This is a chip-level hang: modprobe -r/modprobe
# only detaches and reattaches the Linux driver, it never touches the chip's
# power/reset line, so it cannot recover from this specific failure - only a
# reboot can, because the kernel's mmc power-sequence provider toggles the
# chip's reset line as part of normal boot probing.
brcm_backplane_wedged() {
  dmesg | tail -n 30 | grep -q "brcmf_attach: dongle is not responding"
}

# reload mod
reload_brcm() {
  local attempt
  for attempt in 1 2; do
    modprobe -r brcmfmac
    sleep 1

    if modprobe brcmfmac && wait_for_interface wlan0 10; then
      sleep 1
      iw dev wlan0 set power_save off
      return 0
    fi

    echo "reload_brcm: attempt $attempt failed to bring wlan0 back" >&2
  done

  if brcm_backplane_wedged; then
    # only reboot for an uptime past a sane boot/settle window, so a wedge
    # that somehow persists across reboots doesn't turn into a boot loop
    local uptime_secs
    uptime_secs="$(cut -d. -f1 /proc/uptime)"
    if [ "$uptime_secs" -gt 120 ]; then
      echo "reload_brcm: brcm firmware wedged the SDIO backplane, driver reload cannot recover this - rebooting" >&2
      sync
      reboot
      sleep 60
    fi
  fi

  return 1
}

# starts mon0
start_monitor_interface() {
  rfkill unblock all

  if ! ifconfig wlan0 up; then
    echo "start_monitor_interface: failed to bring up wlan0" >&2
    return 1
  fi

  if ! wait_for_interface wlan0 10; then
    echo "start_monitor_interface: wlan0 not ready" >&2
    return 1
  fi

  local phy
  phy="$(phy_for_interface wlan0)"
  if [ -z "$phy" ]; then
    echo "start_monitor_interface: could not resolve phy for wlan0" >&2
    return 1
  fi

  # clean up a stale wlan0mon left over from an unclean stop, so re-creating it is idempotent
  if [ -e /sys/class/net/wlan0mon ]; then
    iw dev wlan0mon del 2>/dev/null
  fi

  if ! iw phy "$phy" interface add wlan0mon type monitor; then
    echo "start_monitor_interface: failed to create wlan0mon on $phy" >&2
    return 1
  fi

  if ! wait_for_interface wlan0mon 10; then
    echo "start_monitor_interface: wlan0mon did not appear after creation" >&2
    return 1
  fi

  ifconfig wlan0 down
  ifconfig wlan0mon up
  iw dev wlan0mon set power_save off
  return 0
}

# stops mon0
stop_monitor_interface() {
  if [ -e /sys/class/net/wlan0mon ]; then
    ifconfig wlan0mon down
    iw dev wlan0mon del
  fi
  reload_brcm
  ifconfig wlan0 up
}

# returns 0 if the specified network interface is up
is_interface_up() {
  if grep -qi 'up' /sys/class/net/"$1"/operstate; then
    return 0
  fi
  return 1
}

# returns 0 if conditions for AUTO mode are met
is_auto_mode() {
  # check override file first
  if [ -f /root/.pwnagotchi-manual ]; then
    # remove the override file if found
    rm -rf /root/.pwnagotchi-manual
    return 1
  fi

  # check override file first
  if [ -f /root/.pwnagotchi-auto ]; then
    # remove the override file if found
    rm -rf /root/.pwnagotchi-auto
    return 0
  fi

  # if usb0 is up, we're in MANU
  if is_interface_up usb0; then
    return 1
  fi

  # if eth0 is up (for other boards), we're in MANU
  if is_interface_up eth0; then
    return 0
  fi

  # no override, but none of the interfaces is up -> AUTO
  return 0
}

# returns 0 if conditions for AUTO mode are met
is_auto_mode_no_delete() {
  # check override file first
  if [ -f /root/.pwnagotchi-manual ]; then
    return 1
  fi

  # check override file first
  if [ -f /root/.pwnagotchi-auto ]; then
    return 0
  fi

  # if usb0 is up, we're in MANU
  if is_interface_up usb0; then
    return 1
  fi

  # if eth0 is up (for other boards), we're in MANU
  if is_interface_up eth0; then
    return 0
  fi

  # no override, but none of the interfaces is up -> AUTO
  return 0
}

# check if we need to decrypt something
is_crypted_mode() {
  if [ -f /root/.pwnagotchi-crypted ]; then
    return 0
  fi
  return 1
}

# decryption loop
is_decrypted() {
  while read -r mapping container mount; do
    # mapping   = name the device or file will be mapped to
    # container = the luks encrypted device or file
    # mount     = the mountpoint

    # fail if not mounted
    if ! mountpoint -q "$mount" >/dev/null 2>&1; then
      if [ -f /tmp/.pwnagotchi-secret-"$mapping" ]; then
        </tmp/.pwnagotchi-secret-"$mapping" read -r SECRET
        if ! test -b /dev/disk/by-id/dm-uuid-*"$(cryptsetup luksUUID "$container" | tr -d -)"*; then
          if echo -n "$SECRET" | cryptsetup luksOpen -d- "$container" "$mapping" >/dev/null 2>&1; then
            echo "Container decrypted!"
          fi
        fi

        if mount /dev/mapper/"$mapping" "$mount" >/dev/null 2>&1; then
            echo "Mounted /dev/mapper/$mapping to $mount"
            continue
        fi
      fi

      if ! ip -4 addr show wlan0 | grep inet >/dev/null 2>&1; then
        >/dev/null 2>&1 ip addr add 192.168.0.10/24 dev wlan0
      fi

      if ! pgrep -f decryption-webserver >/dev/null 2>&1; then
        >/dev/null 2>&1 decryption-webserver &
      fi

      if ! pgrep wpa_supplicant >/dev/null 2>&1; then
        >/tmp/wpa_supplicant.conf cat <<EOF
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
ap_scan=2

network={
    ssid="DECRYPT-ME"
    mode=2
    key_mgmt=WPA-PSK
    psk="pwnagotchi"
    frequency=2437
}
EOF
        >/dev/null 2>&1 wpa_supplicant -u -s -O -D nl80211 -i wlan0 -c /tmp/wpa_supplicant.conf &
      fi

      if ! pgrep dnsmasq >/dev/null 2>&1; then
        >/dev/null 2>&1 dnsmasq -k -p 53 -h -O "6,192.168.0.10" -A "/#/192.168.0.10" -i wlan0 -K -F 192.168.0.50,192.168.0.60,255.255.255.0,24h &
      fi

      return 1
    fi
  done </root/.pwnagotchi-crypted

  # overwrite passwords
  python3 -c 'print("A"*4096)' | tee /tmp/.pwnagotchi-secret-* >/dev/null
  # delete
  rm /tmp/.pwnagotchi-secret-*
  sync # flush

  pkill wpa_supplicant
  pkill dnsmasq
  pid="$(pgrep -f "decryption-webserver")"
  [[ -n "$pid" ]] && kill "$pid"

  return 0
}
