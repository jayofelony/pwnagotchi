[Unit]
Description=pwnagotchi auto-update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A pip install of pwnagotchi (cloning the repo, then building any
# dependency that has no prebuilt wheel for this arch) can easily take
# longer than systemd's default 90s start timeout on a Pi Zero 2 W, which
# would otherwise kill it mid-install and leave the venv half-updated.
TimeoutStartSec=1200
ExecStart=/usr/bin/auto-update.sh
