[Unit]
Description=pwnagotchi auto-update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A DKMS kernel module build (e.g. brcmfmac-nexmon-dkms) can easily take
# longer than systemd's default 90s start timeout on a Pi Zero 2 W, which
# would otherwise kill the build mid-compile and leave the package
# half-configured (see issue #618).
TimeoutStartSec=1200
ExecStart=/usr/bin/auto-update.sh
